APP_NAME=MedUnderwrite AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=qwen2.5:3b
REASONING_MODEL=gemma3:4b
REFLECTION_MODEL=gemma3:4b

GROQ_API_KEY=
GROQ_PLANNER_MODEL=
GROQ_REASONING_MODEL=
GROQ_REFLECTION_MODEL=

GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_REFLECTION_MODEL=

TEMPERATURE=0.1
MAX_TOKENS=4096

SQLITE_PATH=data/medunderwrite.db

DATA_ROOT=data
RAW_DATA_PATH=data/raw
SYNTHETIC_DATA_PATH=data/synthetic
PROCESSED_DATA_PATH=data/processed
CHROMA_PATH=data/processed/chroma

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K_RESULTS=5

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medunderwrite-ai

CORS_ORIGINS=http://localhost:4200

SECRET_KEY=development-secret-key
